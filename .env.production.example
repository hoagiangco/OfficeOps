# ==============================================================================
# CAU HINH MOI TRUONG PRODUCTION - OFFICEOPS
# Doi ten file nay thanh .env tren VPS hoac su dung truc tiep khi trien khai
# ==============================================================================

# 1. THIET LAP HE THONG & CONG (SYSTEM & PORT)
NODE_ENV="production"
PORT=3003
HOSTNAME="0.0.0.0"

# Duong dan URL cong khai cua he thong tren VPS (Domain HTTPS hoac IP)
# Vi du: https://officeops.yourcompany.vn hoac http://103.xxx.xxx.xxx:3003
NEXT_PUBLIC_APP_URL="https://tech.mayvanphongxanh.com"

# 2. CO SO DU LIEU POSTGRESQL (VPS DATABASE)
# Cau hinh user, password, ten database tuong ung tren PostgreSQL cua VPS
DATABASE_URL="postgresql://officeops_user:your_strong_password@localhost:5432/officeops_prod?schema=public"

# 3. BAO MAT PHIEN LAM VIEC & MA HOA COOKIE/JWT (AUTH_SECRET)
# Tao chuoi ngau nhien dai 32+ ky tu (VD tren terminal VPS: openssl rand -base64 32)
AUTH_SECRET="your-super-strong-auth-secret-here-at-least-32-chars"

# 4. KHOA BAO VE API CRON TU DONG (CRON_SECRET)
# Dung de xac thuc cac tac vu dinh ky tu dong (VD: curl -H "Authorization: Bearer <CRON_SECRET>" .../api/cron/daily)
# Tao chuoi ngau nhien (VD tren terminal VPS: openssl rand -hex 32)
CRON_SECRET="your-strong-cron-secret-hex-key-here"

# 5. THU MUC LUU TRU TEP TAI LEN (UPLOADS DIR)
# Duong dan tuong doi tu thu muc du an hoac duong dan tuyet doi tren VPS
UPLOAD_DIR="public/uploads"

# 6. CAU HINH SAO LUU DU PHONG (DATABASE BACKUP)
# Thu muc luu cac ban sao luu database tren VPS (Linux)
BACKUP_DIR="/var/backups/officeops"
# So ngay luu tru truoc khi tu dong xoa ban sao luu cu
BACKUP_RETENTION_DAYS="30"

# 7. CAU HINH DICH VU EMAIL THONG BAO (SMTP)
# Ho tro: Gmail App Password, Resend, SendGrid, Amazon SES,...
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
MAIL_FROM="OfficeOps System <no-reply@yourcompany.vn>"

# 8. CAU HINH ZALO OFFICIAL ACCOUNT (OA) & ZALO NOTIFICATION SERVICE (ZNS)
# Dang ky ung dung tai https://developers.zalo.me va OA tai https://oa.zalo.me
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ID=""
ZALO_REFRESH_TOKEN=""
# Hoac Access Token truc tiep neu co:
ZALO_ACCESS_TOKEN=""

# Template ID cho cac mau tin ZNS
ZNS_TPL_TICKET_ASSIGNED="TPL_TICKET_ASSIGNED_DEMO"
ZNS_TPL_INVOICE_SENT="TPL_INVOICE_SENT_DEMO"
ZNS_TPL_TICKET_COMPLETED="TPL_TICKET_COMPLETED_DEMO"
