# ==============================================================================
# CẤU HÌNH MÔI TRƯỜNG PRODUCTION - OFFICEOPS
# Đổi tên file này thành .env trên VPS hoặc sử dụng trực tiếp khi triển khai
# ==============================================================================

# 1. THIẾT LẬP HỆ THỐNG & CỔNG
NODE_ENV="production"
PORT=5000
HOSTNAME="0.0.0.0"

# Đường dẫn URL công khai của hệ thống trên VPS (Domain HTTPS hoặc IP)
# Ví dụ: https://officeops.yourcompany.vn hoặc http://103.xxx.xxx.xxx:5000
NEXT_PUBLIC_APP_URL="https://officeops.yourcompany.vn"

# 2. CƠ SỞ DỮ LIỆU POSTGRESQL (VPS)
# Cấu hình user, password, tên database tương ứng trên PostgreSQL của VPS
DATABASE_URL="postgresql://officeops_user:your_strong_password@localhost:5432/officeops_prod?schema=public"

# 3. BẢO MẬT PHIÊN LÀM VIỆC & MÃ HÓA COOKIE/JWT
# Tạo chuỗi ngẫu nhiên dài 32+ ký tự (VD trên terminal VPS: openssl rand -base64 32)
AUTH_SECRET="your-super-strong-auth-secret-here-at-least-32-chars"

# 4. KHÓA BẢO VỆ API CRON TỰ ĐỘNG
# Được dùng để xác thực các tác vụ định kỳ tự động (VD: curl -H "Authorization: Bearer <CRON_SECRET>" .../api/cron/daily)
# Tạo chuỗi ngẫu nhiên (VD trên terminal VPS: openssl rand -hex 32)
CRON_SECRET="your-strong-cron-secret-hex-key-here"

# 5. THƯ MỤC LƯU TRỮ TỆP TẢI LÊN (UPLOADS)
# Đường dẫn tương đối từ thư mục dự án hoặc đường dẫn tuyệt đối trên VPS
UPLOAD_DIR="public/uploads"

# 6. CẤU HÌNH SAO LƯU DỰ PHÒNG (DATABASE BACKUP)
# Thư mục lưu các bản sao lưu database trên VPS (Linux)
BACKUP_DIR="/var/backups/officeops"
# Số ngày lưu trữ trước khi tự động xóa bản sao lưu cũ
BACKUP_RETENTION_DAYS="30"

# 7. CẤU HÌNH DỊCH VỤ EMAIL THÔNG BÁO (SMTP)
# Hỗ trợ: Gmail App Password, Resend, SendGrid, Amazon SES,...
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
MAIL_FROM="OfficeOps System <no-reply@yourcompany.vn>"

# 8. CẤU HÌNH ZALO OFFICIAL ACCOUNT (OA) & ZALO NOTIFICATION SERVICE (ZNS)
# Đăng ký ứng dụng tại https://developers.zalo.me và OA tại https://oa.zalo.me
ZALO_APP_ID=""
ZALO_APP_SECRET=""
ZALO_OA_ID=""
ZALO_REFRESH_TOKEN=""
# Hoặc Access Token trực tiếp nếu có:
ZALO_ACCESS_TOKEN=""

# Template ID cho các mẫu tin ZNS
ZNS_TPL_TICKET_ASSIGNED="TPL_TICKET_ASSIGNED_DEMO"
ZNS_TPL_INVOICE_SENT="TPL_INVOICE_SENT_DEMO"
ZNS_TPL_TICKET_COMPLETED="TPL_TICKET_COMPLETED_DEMO"
