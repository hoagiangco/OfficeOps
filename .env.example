DATABASE_URL="postgresql://postgres:password@localhost:5432/officeops?schema=public"
AUTH_SECRET="change-me-to-a-long-random-string"
CRON_SECRET="change-me-to-a-long-random-cron-secret"

# Cấu hình sao lưu Database (backup)
# Đường dẫn thư mục lưu file sao lưu .sql (tuyệt đối hoặc tương đối)
BACKUP_DIR="E:\Backup\officeops"
# Số ngày lưu trữ trước khi tự động xóa bản sao lưu cũ
BACKUP_RETENTION_DAYS="14"

# Cấu hình SMTP gửi Email (Gmail App Password hoặc Resend/SendGrid)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
MAIL_FROM="OfficeOps System <no-reply@officeops.vn>"
NEXT_PUBLIC_APP_URL="http://localhost:5000"
